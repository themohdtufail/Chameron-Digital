# Database (Postgres)
DATABASE_URL="postgresql://chameron:chameron_dev_pw@localhost:5432/chameron_digital"
# Used by Prisma Migrate for schema changes. On a plain Postgres instance this
# is identical to DATABASE_URL. On Neon (or any provider with a separate
# pooled/PgBouncer endpoint), this MUST be the direct/unpooled connection
# string — migrations fail over a pooled connection.
DIRECT_URL="postgresql://chameron:chameron_dev_pw@localhost:5432/chameron_digital"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_DAYS="30"

# Admin bootstrap (used by prisma/seed.ts)
ADMIN_PHONE="+911234567890"
ADMIN_PASSWORD="ChameronAdmin@123"

# OTP
# In development OTPs are logged to the server console and this fixed code
# always works, so you can test the flow without an SMS provider.
OTP_DEV_MODE="true"
OTP_DEV_STATIC_CODE="123456"

# File storage
# "local" stores uploads under /public/uploads — fine for development, but
# Vercel's filesystem is ephemeral, so this must NEVER be used in
# production/preview deployments (uploads vanish on the next deploy).
# Switch to "s3" and fill in every S3_* var below for production — if
# STORAGE_DRIVER=s3 and any of them is missing, uploads fail loudly at
# request time rather than silently falling back to local storage.
# See docs/STORAGE.md for the required AWS resources, bucket policy, and
# minimum IAM permissions.
STORAGE_DRIVER="local"
# Required when STORAGE_DRIVER=s3:
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: only set this if a CDN (e.g. CloudFront) sits in front of the
# bucket's public/ prefix — public upload URLs are built from this instead
# of the raw S3 endpoint. Leave blank to use the default S3 URL.
S3_PUBLIC_URL=""

# App
NEXT_PUBLIC_APP_NAME="Chameron Digital"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
