# Database (Postgres)
DATABASE_URL="postgresql://chameron:chameron_dev_pw@localhost:5432/chameron_digital"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_DAYS="30"

# Admin bootstrap (used by prisma/seed.ts)
ADMIN_PHONE="+911234567890"
ADMIN_PASSWORD="ChameronAdmin@123"

# OTP
# In development OTPs are logged to the server console and this fixed code
# always works, so you can test the flow without an SMS provider.
OTP_DEV_MODE="true"
OTP_DEV_STATIC_CODE="123456"

# File storage
# "local" stores uploads under /public/uploads (good for dev/demo).
# Switch to "s3" and fill the S3_* vars for production.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# App
NEXT_PUBLIC_APP_NAME="Chameron Digital"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
